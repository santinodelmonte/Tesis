@page
@model Tesis.Pages.PagesProduccion.ListaLactanciasModel
@{
}
<div>
    <h1>Lactancias</h1>
    <p class="text-muted">
        @Model.lactancias.Count lactancias registradas, @Model.cantidadActivas en curso.
    </p>
    @* Las alertas de secado y el historial estan en el menu, en Pendientes y en
       Produccion. Aca queda lo que se hace sobre las lactancias. *@
    <div class="row">
        <div class="col-sm-12 text-end">
            <a class="btn btn-primary" asp-page="./AltaLactancia">Abrir lactancia</a>
            <a class="btn btn-primary" asp-page="./RegistrarSecado">Registrar secado</a>
        </div>
    </div>
    <table data-paginar="10" class="table">
        <thead>
            <tr>
                <th>Caravana</th>
                <th>Numero</th>
                <th>Inicio</th>
                <th>Secado</th>
                <th>Fecha probable de parto</th>
                <th>Dias en leche</th>
                <th>Controles</th>
                <th>Litros medidos</th>
                <th>Produccion estimada</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.lactancias.Any())
            {
                @foreach (Dominio.Lactancia lactancia in Model.lactancias)
                {
                    <tr>
                        <td>@(lactancia.Animal != null ? lactancia.Animal.NumCaravana : "")</td>
                        <td>@lactancia.NumeroLactancia</td>
                        <td>@lactancia.FechaInicio.ToShortDateString()</td>
                        <td>
                            @if (lactancia.FechaSecado != DateTime.MinValue)
                            {
                                @lactancia.FechaSecado.ToShortDateString()
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>
                            @if (lactancia.FechaProbableParto != DateTime.MinValue)
                            {
                                @lactancia.FechaProbableParto.ToShortDateString()
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>@Model.diasEnLeche[lactancia.IdLactancia]</td>
                        <td>@Model.controles[lactancia.IdLactancia]</td>
                        <td>@Model.produccion[lactancia.IdLactancia].ToString("N2")</td>
                        <td>@Model.estimada[lactancia.IdLactancia].ToString("N0")</td>
                        <td>
                            @if (lactancia.FechaSecado == DateTime.MinValue)
                            {
                                <span class="badge bg-success">En curso</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cerrada</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No hay lactancias registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
