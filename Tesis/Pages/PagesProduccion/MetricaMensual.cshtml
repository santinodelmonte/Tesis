@page
@model Tesis.Pages.PagesProduccion.MetricaMensualModel
@{
    string[] nombresMes = new string[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Metrica de Produccion Mensual</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="mes">Mes:</label>
                    <select id="mes" name="mes" asp-for="mes" class="form-control">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@nombresMes[i - 1]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="anio">Año:</label>
                    <select id="anio" name="anio" asp-for="anio" class="form-control">
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 10; i--)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>&nbsp;</label><br />
                    <button type="submit" class="btn btn-primary" asp-page-handler="Consultar">Consultar</button>
                    <a class="btn btn-secondary" asp-page="./HistorialProduccion">Historial</a>
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
    </form>

    @if (Model.consultado)
    {
        <hr />
        <div class="alert alert-success">
            <h3 class="mb-0">@Model.totalMensual.ToString("N2") litros</h3>
            <small>Producción de @nombresMes[Model.mes - 1] de @Model.anio</small>
        </div>
        <table class="table text-center">
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th>Registros</th>
                    <th>Litros</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-success">
                    <td>
                        <strong>Producción del establecimiento</strong>
                        <br /><small class="text-muted">
                            La leche que salió en los ordeñes del mes.
                        </small>
                    </td>
                    <td>@Model.cantidadOrdeniesLote ordeñe(s)</td>
                    <td><strong>@Model.totalLote.ToString("N2")</strong></td>
                </tr>
                <tr>
                    <td>
                        Medido en control individual
                        <br /><small class="text-muted">
                            Parte de esos mismos litros, repartidos por animal. No se suma
                            al total: es la porción de la producción que se midió vaca por
                            vaca.
                        </small>
                    </td>
                    <td>@Model.cantidadControles control(es)</td>
                    <td>@Model.totalIndividual.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    }
</div>
