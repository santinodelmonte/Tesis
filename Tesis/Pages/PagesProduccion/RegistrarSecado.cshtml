@page
@model Tesis.Pages.PagesProduccion.RegistrarSecadoModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Registrar Periodo de Secado</h1>
    <p class="text-muted">
        Cierra la lactancia vigente y saca al animal del ordeñe. El estado reproductivo
        no se modifica: una vaca seca puede estar preñada, y de hecho es lo habitual.
    </p>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Hembra', 'H', true)">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="fechaSecado">Fecha de secado:</label>
                    <input type="date" id="fechaSecado" name="fechaSecado" class="form-control"
                           value="@Model.fechaSecado.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="RegistrarSecado">Registrar Secado</button>
                <a class="btn btn-info" asp-page="./AlertasSecado">Alertas de Secado</a>
                <a class="btn btn-warning" asp-page="./ListaLactancias">Volver</a>
            </div>
        </div>
    </form>

    <hr />
    <h5>Animales en ordeñe (@Model.enLactancia.Count)</h5>
    <table class="table table-sm text-center">
        <thead>
            <tr>
                <th>Caravana</th>
                <th>Categoria</th>
                <th>Estado reproductivo</th>
                <th>Secado recomendado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.enLactancia.Any())
            {
                @foreach (Dominio.Hembra hembra in Model.enLactancia)
                {
                    <tr>
                        <td>@hembra.NumCaravana</td>
                        <td>@(hembra.Categoria != null ? hembra.Categoria.Nombre : "")</td>
                        <td>@hembra.EstadoReproductivo</td>
                        <td>
                            @if (Model.fechasRecomendadas[hembra.IdAnimal] != DateTime.MinValue)
                            {
                                @Model.fechasRecomendadas[hembra.IdAnimal].ToShortDateString()
                            }
                            else
                            {
                                <span class="text-muted">Sin preñez confirmada</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No hay animales en lactancia.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
