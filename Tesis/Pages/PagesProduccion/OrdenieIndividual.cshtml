@page
@model Tesis.Pages.PagesProduccion.OrdenieIndividualModel
@{
    ViewData["Title"] = Model.esCorreccion ? "Corregir control" : "Control de una vaca";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="panel-formulario">
    @if (Model.esCorreccion)
    {
        <h1>Corregir Control Individual</h1>
        <p class="text-muted">
            Se corrigen los litros. La fecha, el turno y el animal identifican al control:
            si lo que está mal es alguno de esos tres, el camino es eliminarlo desde el
            historial y volver a cargarlo.
        </p>
    }
    else
    {
        <h1>Control de una Vaca</h1>
        <p class="text-muted">
            La carga puntual del control lechero: la vaca que faltó el día del control, una
            medición suelta o una carga retroactiva. Para medir todo el rodeo de una vez está
            el <a asp-page="./ControlLechero">control lechero</a>. Los dos guardan lo mismo:
            lo que dio ese animal en ese turno, imputado a la lactancia de esa fecha.
        </p>
    }
    <hr />
    <form method="post">
        <input type="hidden" name="id" value="@Model.id" />
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="turno">Turno:</label>
                    @if (Model.esCorreccion)
                    {
                        <input type="text" id="turno" class="form-control" readonly value="@Model.turno" />
                    }
                    else
                    {
                        <select id="turno" name="turno" asp-for="turno" class="form-control">
                            @foreach (string unTurno in Model.turnos)
                            {
                                <option value="@unTurno">@unTurno</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fecha">Fecha:</label>
                    @if (Model.esCorreccion)
                    {
                        <input type="text" id="fecha" class="form-control" readonly
                               value="@Model.fecha.ToShortDateString()" />
                    }
                    else
                    {
                        <input type="date" id="fecha" name="fecha" class="form-control"
                               value="@Model.fecha.ToString("yyyy-MM-dd")" />
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    @if (Model.esCorreccion)
                    {
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                    }
                    else
                    {
                        <div class="input-group">
                            <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                            <input type="text" id="caravanaTexto" class="form-control" readonly
                                   value="@Model.numCaravana" />
                            <button type="button" class="btn btn-secondary"
                                    onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Hembra', 'H', true)">
                                Buscar
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="litros">Litros:</label>
                    <input type="number" step="0.01" min="0" id="litros" name="litros"
                           class="form-control" value="@Tesis.Pages.Shared.CampoNumerico.Escribir(Model.litros)" />
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">
                    @(Model.esCorreccion ? "Guardar corrección" : "Guardar")
                </button>
                @if (Model.esCorreccion)
                {
                    <a class="btn btn-outline-secondary" asp-page="./HistorialProduccion">Cancelar</a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-page="./ControlLechero">Control lechero</a>
                    <a class="btn btn-warning" asp-page="./HistorialProduccion">Historial</a>
                }
            </div>
        </div>
    </form>

    @if (!Model.esCorreccion && Model.ultimosControles.Any())
    {
        <hr />
        <h2 class="h5">Controles de los ultimos siete dias</h2>
        <table data-paginar="10" class="table table-sm">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Turno</th>
                    <th>Caravana</th>
                    <th>Litros</th>
                    <th>Lactancia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Dominio.OrdenieIndividual control in Model.ultimosControles)
                {
                    <tr>
                        <td>@control.Fecha.ToShortDateString()</td>
                        <td>@control.Turno</td>
                        <td>@(control.Animal != null ? control.Animal.NumCaravana : "")</td>
                        <td>@control.Litros.ToString("N2")</td>
                        <td>@(control.Lactancia != null ? control.Lactancia.NumeroLactancia.ToString() : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (!Model.esCorreccion)
{
    <partial name="_SelectorAnimal" model="Model.animales" />
}
