@page
@model Tesis.Pages.PagesSeguridad.LoginModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Iniciar Sesión</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">

                <div class="form-group">
                    <label for="usuario">Usuario:</label>
                    <input asp-for="usuario" type="text" class="form-control" id="usuario" name="usuario">
                    <span class="validation" asp-validation-for="usuario"></span>
                </div>
                <div class="form-group">
                    <label for="contrasena">Contraseña:</label>
                    <input asp-for="contrasena" type="password" class="form-control" id="contrasena" name="contrasena">
                    <span class="validation" asp-validation-for="contrasena"></span>
                </div>
            </div>

        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <br />
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="Ingresar">Ingresar</button>
            </div>
        </div>

    </form>

</div>
