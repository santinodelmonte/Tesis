@page
@model Tesis.Pages.PagesSeguridad.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
@*
    Es la primera pantalla que se ve, así que se lleva un tratamiento propio:
    una tarjeta centrada en vez de un formulario suelto arriba a la izquierda.
    Los dos campos van uno debajo del otro y a lo ancho de la tarjeta, que es
    lo que hace que en un celular se llene sin pelearse con el teclado.
*@
<div class="pantalla-login">
    <div class="tarjeta-login">
        <h1 class="h4 mb-1">Iniciar sesión</h1>
        <p class="text-muted mb-4">Gestión de Tambo</p>

        <form method="post">
            <div class="form-group">
                <label for="usuario">Usuario</label>
                <input asp-for="usuario" type="text" class="form-control" id="usuario"
                       name="usuario" autocomplete="username" autofocus>
                <span class="validation" asp-validation-for="usuario"></span>
            </div>

            <div class="form-group">
                <label for="contrasena">Contraseña</label>
                <input asp-for="contrasena" type="password" class="form-control" id="contrasena"
                       name="contrasena" autocomplete="current-password">
                <span class="validation" asp-validation-for="contrasena"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <button type="submit" class="btn btn-primary w-100 mt-2" asp-page-handler="Ingresar">
                Ingresar
            </button>
        </form>
    </div>
</div>
