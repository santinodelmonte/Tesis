@page
@model Tesis.Pages.PagesAnimal.EliminarAnimalModel
@{
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Eliminar Animal</h1>
    <hr />
    @if (Model.animal != null)
    {
        <p class="text-danger">
            El borrado es definitivo y se usa solo para corregir cargas erroneas.
            Si el animal salio del rodeo, corresponde registrar la baja.
        </p>
        <dl class="row">
            <dt class="col-sm-2">
                Numero de Caravana
            </dt>
            <dd class="col-sm-10">
                @Model.animal.NumCaravana
            </dd>
            <dt class="col-sm-2">
                Sexo
            </dt>
            <dd class="col-sm-10">
                @(Model.animal is Dominio.Hembra ? "Hembra" : "Macho")
            </dd>
            <dt class="col-sm-2">
                Fecha de Nacimiento
            </dt>
            <dd class="col-sm-10">
                @Model.animal.FechaNacimiento.ToShortDateString()
            </dd>
            <dt class="col-sm-2">
                Raza
            </dt>
            <dd class="col-sm-10">
                @(Model.animal.Raza != null ? Model.animal.Raza.Nombre : "")
            </dd>
            <dt class="col-sm-2">
                Categoria
            </dt>
            <dd class="col-sm-10">
                @(Model.animal.Categoria != null ? Model.animal.Categoria.Nombre : "")
            </dd>
        </dl>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <form method="post">
            <input type="hidden" id="id" name="id" value="@Model.animal.IdAnimal" />
            <div class="row">
                <div class="mt-2">
                    <button type="submit" class="btn btn-danger" asp-page-handler="EliminarAnimal">Eliminar</button>
                    <a class="btn btn-warning" asp-page="./DetalleAnimal" asp-route-id="@Model.animal.IdAnimal">Volver</a>
                </div>
            </div>
        </form>
    }
    else
    {
        <p>No se encontro el animal solicitado.</p>
        <a class="btn btn-warning" asp-page="./ListaAnimales">Volver</a>
    }

</div>
