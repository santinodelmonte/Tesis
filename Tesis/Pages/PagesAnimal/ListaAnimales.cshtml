@page
@model Tesis.Pages.PagesAnimal.ListaAnimalesModel
@{
}
<div>
    <h1>Lista de Animales</h1>
    <p class="text-muted">
        Rodeo actual: @Model.animales.Count animales activos.
        Los animales dados de baja se consultan desde <a asp-page="./BuscarAnimales">Buscar y Filtrar</a>.
    </p>
    @if (Model.categoriasDesactualizadas.Count > 0)
    {
        <div class="alert alert-warning">
            @Model.categoriasDesactualizadas.Count animal(es) cambiaron de condicion y su categoria
            quedo desactualizada. Se marcan abajo con la categoria que les corresponde.
        </div>
    }
    @* Buscar, linaje y consanguinidad estan en el menu, en la seccion Animales: eran
       tres accesos repetidos que no pertenecen a esta pantalla. Aca queda lo que se
       hace sobre el rodeo que se esta mirando. *@
    <div class="row">
        <div class="col-sm-12 text-end">
            <a class="btn btn-primary" asp-page="./AltaAnimal">Agregar animal</a>
        </div>
    </div>
    <table data-paginar="10" class="table">
        <thead>
            <tr>
                <th>Caravana</th>
                <th>Sexo</th>
                <th>Fecha de Nacimiento</th>
                <th>Raza</th>
                <th>Categoria</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.animales != null && Model.animales.Any())
            {
                @foreach (Dominio.Animal animal in Model.animales)
                {
                    <tr>
                        <td>@animal.NumCaravana</td>
                        <td>@(animal is Dominio.Hembra ? "Hembra" : "Macho")</td>
                        <td>@animal.FechaNacimiento.ToShortDateString()</td>
                        <td>@(animal.Raza != null ? animal.Raza.Nombre : "")</td>
                        <td>
                            @(animal.Categoria != null ? animal.Categoria.Nombre : "")
                            @if (Model.categoriasDesactualizadas.ContainsKey(animal.IdAnimal))
                            {
                                <br />
                                <span class="badge bg-warning text-dark">
                                    Corresponde @Model.categoriasDesactualizadas[animal.IdAnimal]
                                </span>
                            }
                        </td>
                        <td>
                            <div class="mt-2">
                                <a class="btn btn-primary" asp-page="./ModificarAnimal" asp-route-id="@animal.IdAnimal">Modificar</a>
                                <a class="btn btn-warning" asp-page="./DetalleAnimal" asp-route-id="@animal.IdAnimal">Detalle</a>
                                <a class="btn btn-secondary" asp-page="./BajaAnimal" asp-route-id="@animal.IdAnimal">Baja</a>
                            </div>
                            @if (Model.categoriasDesactualizadas.ContainsKey(animal.IdAnimal))
                            {
                                <form method="post" asp-page-handler="ActualizarCategoria" asp-route-id="@animal.IdAnimal" class="mt-2">
                                    <button type="submit" class="btn btn-warning btn-sm">Actualizar Categoria</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No hay animales ingresados
                    </td>
                </tr>
            }

        </tbody>
    </table>

    @* Los reproductores de catalogo no son parte del rodeo: no comen, no se vacunan y
       no se venden. Existen para que las pajuelas tengan padre y la genealogia de las
       crias por inseminacion se pueda reconstruir. Se muestran igual, porque hay que
       poder consultarlos y corregirles un dato, pero aparte y sin la baja: darlos de
       baja los sacaria de los desplegables donde si hacen falta. *@
    @if (Model.reproductoresCatalogo.Any())
    {
        <h2 class="h5 mt-4">Reproductores de catálogo</h2>
        <p class="text-muted">
            @Model.reproductoresCatalogo.Count toro(s) que aportan pajuelas al stock sin
            integrar el rodeo. No se cuentan entre los animales del establecimiento ni
            entran en los planes sanitarios, pero figuran en la genealogía de las crías
            que nacen por inseminación.
        </p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Caravana</th>
                    <th>Fecha de Nacimiento</th>
                    <th>Raza</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Dominio.Animal toro in Model.reproductoresCatalogo)
                {
                    <tr>
                        <td>@toro.NumCaravana</td>
                        <td>@toro.FechaNacimiento.ToShortDateString()</td>
                        <td>@(toro.Raza != null ? toro.Raza.Nombre : "")</td>
                        <td>
                            <a class="btn btn-primary btn-sm" asp-page="./ModificarAnimal" asp-route-id="@toro.IdAnimal">Modificar</a>
                            <a class="btn btn-warning btn-sm" asp-page="./DetalleAnimal" asp-route-id="@toro.IdAnimal">Detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
