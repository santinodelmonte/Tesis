@page
@model Tesis.Pages.PagesAnimal.BuscarAnimalesModel
@{
    Dominio.Controladora unaControladora = new Dominio.Controladora();
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Buscar y Filtrar Animales del Rodeo</h1>
    <hr />
    <form method="post">

        <div class="card mb-4">
            <div class="card-header bg-primary text-light">
                Filtros del rodeo
            </div>
            <div class="card-body">

                <p class="text-muted">
                    Todos los filtros son opcionales y se combinan entre si. Dejalos vacios para no aplicarlos.
                </p>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="estado">Estado:</label>
                            <select id="estado" name="estado" class="form-control">
                                <option value="-1" selected="@(Model.estado == -1)">Todos</option>
                                <option value="1" selected="@(Model.estado == 1)">Activos</option>
                                <option value="0" selected="@(Model.estado == 0)">Inactivos (dados de baja)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="idCategoria">Categoria:</label>
                            <select id="idCategoria" name="idCategoria" class="form-control">
                                <option value="0">Todas las Categorias</option>
                                @foreach (var item in Model.categorias)
                                {
                                    <option value="@item.IdCategoria" selected="@(Model.idCategoria == item.IdCategoria)">@item.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="idRaza">Raza:</label>
                            <select id="idRaza" name="idRaza" class="form-control">
                                <option value="0">Todas las Razas</option>
                                @foreach (var item in Model.razas)
                                {
                                    <option value="@item.IdRaza" selected="@(Model.idRaza == item.IdRaza)">@item.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Edad en meses:</label>
                            <div class="input-group">
                                <span class="input-group-text">Desde</span>
                                <input type="number" min="0" class="form-control" id="edadDesde" name="edadDesde" value="@Model.edadDesde">
                                <span class="input-group-text">Hasta</span>
                                <input type="number" min="0" class="form-control" id="edadHasta" name="edadHasta" value="@Model.edadHasta">
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <label>Busquedas rapidas:</label>
                <div class="mt-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('rodeo')">Rodeo activo</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('inactivos')">Todos los inactivos</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('crias')">Crias (0 a 12 meses)</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('recria')">Recria (13 a 24 meses)</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('vacas')">Vacas</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('toros')">Toros</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="aplicarBusquedaRapida('todos')">Todo el historico</button>
                </div>

            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-secondary text-light">
                Buscar un animal en particular
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="numCaravana">Numero de Caravana:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="numCaravana" name="numCaravana" value="@Model.numCaravana" placeholder="Coincidencia parcial, ej: 00">
                                <button type="button" class="btn btn-info" onclick="abrirSelectorAnimal('numCaravana','numCaravana','Buscar Animal','',true)">Elegir de la lista</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>

        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-info" id="btnFiltrar" asp-page-handler="FiltrarAnimales">Aplicar filtros</button>
                <button type="submit" class="btn btn-secondary" asp-page-handler="LimpiarFiltros">Limpiar</button>
                <a class="btn btn-warning" asp-page="./ListaAnimales">Volver</a>
            </div>
        </div>

    </form>
    <hr />

    <h4>
        Resultado: @Model.animales.Count animales
        @if (!Model.filtrado)
        {
            <small class="text-muted">(rodeo activo, sin filtros aplicados)</small>
        }
    </h4>

    <table class="table text-center">
        <thead>
            <tr>
                <th>Caravana</th>
                <th>Sexo</th>
                <th>Fecha de Nacimiento</th>
                <th>Edad (meses)</th>
                <th>Raza</th>
                <th>Categoria</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.animales != null && Model.animales.Any())
            {
                @foreach (Dominio.Animal animal in Model.animales)
                {
                    <tr>
                        <td>@animal.NumCaravana</td>
                        <td>@(animal is Dominio.Hembra ? "Hembra" : "Macho")</td>
                        <td>@animal.FechaNacimiento.ToShortDateString()</td>
                        <td>@unaControladora.CalcularEdadMeses(animal)</td>
                        <td>@(animal.Raza != null ? animal.Raza.Nombre : "")</td>
                        <td>@(animal.Categoria != null ? animal.Categoria.Nombre : "")</td>
                        <td>@(animal.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <div class="mt-2">
                                <a class="btn btn-primary" asp-page="./ModificarAnimal" asp-route-id="@animal.IdAnimal">Modificar</a>
                                <a class="btn btn-warning" asp-page="./DetalleAnimal" asp-route-id="@animal.IdAnimal">Detalle</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No hay animales que coincidan con los filtros
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

<partial name="_SelectorAnimal" model="Model.todosLosAnimales" />

<script>
    function seleccionarPorTexto(pIdSelect, pTexto) {
        var select = document.getElementById(pIdSelect);

        for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].text === pTexto) {
                select.selectedIndex = i;
                return;
            }
        }
        select.selectedIndex = 0;
    }

    function aplicarBusquedaRapida(pTipo) {
        // Se limpia todo y despues se arma la combinacion de cada busqueda
        document.getElementById("numCaravana").value = "";
        document.getElementById("idRaza").value = "0";
        document.getElementById("idCategoria").value = "0";
        document.getElementById("estado").value = "-1";
        document.getElementById("edadDesde").value = "0";
        document.getElementById("edadHasta").value = "0";

        if (pTipo === "rodeo") {
            document.getElementById("estado").value = "1";
        } else if (pTipo === "inactivos") {
            document.getElementById("estado").value = "0";
        } else if (pTipo === "crias") {
            document.getElementById("estado").value = "1";
            document.getElementById("edadHasta").value = "12";
        } else if (pTipo === "recria") {
            document.getElementById("estado").value = "1";
            document.getElementById("edadDesde").value = "13";
            document.getElementById("edadHasta").value = "24";
        } else if (pTipo === "vacas") {
            document.getElementById("estado").value = "1";
            seleccionarPorTexto("idCategoria", "Vaca");
        } else if (pTipo === "toros") {
            document.getElementById("estado").value = "1";
            seleccionarPorTexto("idCategoria", "Toro");
        }

        // Se dispara el boton real para conservar el handler de la pagina
        document.getElementById("btnFiltrar").click();
    }
</script>
