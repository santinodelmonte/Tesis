@page
@model Tesis.Pages.PagesAnimal.BajaAnimalModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Registrar Baja de Animal</h1>
    <hr />
    @if (Model.animal != null)
    {
        <dl class="row">
            <dt class="col-sm-2">
                Numero de Caravana
            </dt>
            <dd class="col-sm-10">
                @Model.animal.NumCaravana
            </dd>
            <dt class="col-sm-2">
                Sexo
            </dt>
            <dd class="col-sm-10">
                @(Model.animal is Dominio.Hembra ? "Hembra" : "Macho")
            </dd>
            <dt class="col-sm-2">
                Fecha de Nacimiento
            </dt>
            <dd class="col-sm-10">
                @Model.animal.FechaNacimiento.ToShortDateString()
            </dd>
            <dt class="col-sm-2">
                Categoria
            </dt>
            <dd class="col-sm-10">
                @(Model.animal.Categoria != null ? Model.animal.Categoria.Nombre : "")
            </dd>
            <dt class="col-sm-2">
                Estado
            </dt>
            <dd class="col-sm-10">
                @(Model.animal.Activo ? "Activo" : "Inactivo")
            </dd>
        </dl>
        <hr />
        <form method="post">
            <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.animal.NumCaravana" />
            <div class="row">
                <div class="col-md-4">

                    <div class="form-group">
                        <label for="motivoBaja">Motivo de Salida:</label>
                        <select id="motivoBaja" name="motivoBaja" asp-for="motivoBaja" class="form-control">
                            <option value="">Seleccione un Motivo</option>
                            @foreach (var item in Model.motivos)
                            {
                                <option value="@item.Nombre">@item.Nombre</option>
                            }
                        </select>
                        <span class="validation" asp-validation-for="motivoBaja"></span>
                    </div>
                </div>

            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
            <br />
            <hr />
            <div class="row">
                <div class="mt-2">
                    <button type="submit" class="btn btn-danger" asp-page-handler="ConfirmarBaja">Confirmar Baja</button>
                    <a class="btn btn-warning" asp-page="./ListaAnimales">Volver</a>
                </div>
            </div>

        </form>
    }
    else
    {
        <p>No se encontro el animal solicitado.</p>
        <a class="btn btn-warning" asp-page="./ListaAnimales">Volver</a>
    }

</div>
