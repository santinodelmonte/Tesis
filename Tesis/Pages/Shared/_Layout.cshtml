<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion de Tambo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tesis.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
</head>
<body>
    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    Gestion de Tambo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @* El menu del sistema solo se muestra con la sesion iniciada *@
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* Modulo 1: Gestion de Animales y Genetica *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Animales</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesAnimal/ListaAnimales">Lista de Animales</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesAnimal/BuscarAnimales">Buscar y Filtrar</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesAnimal/ConsultaLinaje">Consultar Linaje</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesAnimal/VerificarConsanguinidad">Verificar Consanguinidad</a></li>
                                </ul>
                            </li>

                            @* Modulo 2: Control de Produccion *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Produccion</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/OrdenieLote">Ordeñe por Lote</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/OrdenieIndividual">Ordeñe Individual</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/HistorialProduccion">Historial de Produccion</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/MetricaMensual">Metrica Mensual</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/ListaLactancias">Lactancias</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/RegistrarSecado">Registrar Secado</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesProduccion/AlertasSecado">Alertas de Secado</a></li>
                                </ul>
                            </li>

                            @* Modulo 3: Gestion Reproductiva *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Reproduccion</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/RegistrarCelo">Registrar Celo</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/ListaCelos">Celos Detectados</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/RegistrarServicio">Registrar Servicio</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/ListaServicios">Servicios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/RegistrarTacto">Registrar Tacto</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/AlertasParto">Alertas de Parto</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesReproduccion/RegistrarParto">Registrar Parto</a></li>
                                </ul>
                            </li>

                            @* Modulo 4: Gestion Sanitaria *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Sanidad</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/ListaDiagnosticos">Ficha Sanitaria</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/RegistrarDiagnostico">Registrar Diagnostico</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/RegistrarTratamiento">Registrar Tratamiento</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/RegistrarVacunacion">Registrar Vacunacion</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/RegistrarDescorne">Registrar Descorne</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/ListaPlanes">Planes Sanitarios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesSanidad/CalendarioSanitario">Calendario Sanitario</a></li>
                                </ul>
                            </li>

                            @* Modulo 5: Control de Insumos y Stock *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Insumos</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/ListaInsumos">Lista de Insumos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/AltaInsumo">Agregar Insumo</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/IngresoStock">Ingreso de Stock</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/ConfigurarStockMinimo">Configurar Stock Minimo</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/AlertasStock">Alertas de Stock Critico</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/AlertasVencimiento">Alertas de Vencimiento</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/PagesInsumo/HistorialMovimientos">Historial de Movimientos</a></li>
                                </ul>
                            </li>

                            @* Parametros de manejo del establecimiento *@
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/PagesConfiguracion/Configuracion">Configuracion</a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-light">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/PagesSeguridad/Login" asp-page-handler="Salir">
                                    <button type="submit" class="nav-link btn btn-link text-light">Cerrar Sesion</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/PagesSeguridad/Login">Iniciar Sesion</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Pagina sola cualquier tabla que declare data-paginar *@
    <script src="~/js/paginador.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
