@*
    Disposición general del sistema.

    El menú es una columna lateral. Con seis módulos, la barra superior de
    desplegables que había antes obligaba a abrir uno para saber dónde estaba
    parado uno, y la misma pantalla aparecía repetida en varios desplegables
    porque no había un único lugar natural para ella.

    El menú está definido como datos y no como marcado: cada sección es una
    lista de ítems, y cada ítem son las pantallas que lo dejan marcado. La
    primera de esas pantallas es a la que lleva, y las demás son las que
    cuelgan de ella -estando en "Registrar celo" el que corresponde marcar es
    "Celos", que es de donde se llegó-. Verlas todas juntas en una lista es lo
    que deja comprobar de un vistazo que ninguna pantalla quedó sin lugar o en
    dos lugares a la vez, y agregar una entrada es una línea.
*@
@{
    string vPaginaActual = ViewContext.RouteData.Values["page"] as string ?? "";

    var vSecciones = new[]
    {
        new
        {
            Titulo = "Pendientes y alertas",
            Icono = "pendientes",
            Id = "seccionPendientes",
            Items = new[]
            {
                new { Texto = "Vacas para servir", Paginas = new[] { "/PagesReproduccion/VacasParaServir" } },
                new { Texto = "Tactos pendientes", Paginas = new[] { "/PagesReproduccion/TactosPendientes" } },
                new { Texto = "Partos próximos", Paginas = new[] { "/PagesReproduccion/AlertasParto" } },
                new { Texto = "Secados próximos", Paginas = new[] { "/PagesProduccion/AlertasSecado" } },
                new { Texto = "Calendario sanitario", Paginas = new[] { "/PagesSanidad/CalendarioSanitario" } },
                new { Texto = "Stock crítico", Paginas = new[] { "/PagesInsumo/AlertasStock" } },
                new { Texto = "Partidas por vencer", Paginas = new[] { "/PagesInsumo/AlertasVencimiento" } }
            }
        },
        new
        {
            Titulo = "Animales",
            Icono = "animales",
            Id = "seccionAnimales",
            Items = new[]
            {
                new { Texto = "Rodeo", Paginas = new[] { "/PagesAnimal/ListaAnimales", "/PagesAnimal/AltaAnimal", "/PagesAnimal/ModificarAnimal", "/PagesAnimal/BajaAnimal", "/PagesAnimal/DetalleAnimal" } },
                new { Texto = "Buscar y filtrar", Paginas = new[] { "/PagesAnimal/BuscarAnimales" } },
                new { Texto = "Linaje", Paginas = new[] { "/PagesAnimal/ConsultaLinaje" } },
                new { Texto = "Consanguinidad", Paginas = new[] { "/PagesAnimal/VerificarConsanguinidad" } }
            }
        },
        new
        {
            Titulo = "Producción",
            Icono = "produccion",
            Id = "seccionProduccion",
            Items = new[]
            {
                new { Texto = "Ordeñe por lote", Paginas = new[] { "/PagesProduccion/OrdenieLote", "/PagesProduccion/ModificarOrdenieLote" } },
                // El control lechero y la carga de a una vaca son el mismo CU13: la
                // entrada es la carga masiva y la puntual se llega desde adentro.
                new { Texto = "Control lechero", Paginas = new[] { "/PagesProduccion/ControlLechero", "/PagesProduccion/OrdenieIndividual" } },
                new { Texto = "Lactancias", Paginas = new[] { "/PagesProduccion/ListaLactancias", "/PagesProduccion/AltaLactancia", "/PagesProduccion/RegistrarSecado" } },
                new { Texto = "Historial de producción", Paginas = new[] { "/PagesProduccion/HistorialProduccion" } },
                new { Texto = "Métrica mensual", Paginas = new[] { "/PagesProduccion/MetricaMensual" } }
            }
        },
        new
        {
            Titulo = "Reproducción",
            Icono = "reproduccion",
            Id = "seccionReproduccion",
            Items = new[]
            {
                new { Texto = "Celos", Paginas = new[] { "/PagesReproduccion/ListaCelos", "/PagesReproduccion/RegistrarCelo" } },
                new { Texto = "Servicios", Paginas = new[] { "/PagesReproduccion/ListaServicios", "/PagesReproduccion/RegistrarServicio" } },
                new { Texto = "Tactos", Paginas = new[] { "/PagesReproduccion/ListaTactos", "/PagesReproduccion/RegistrarTacto" } },
                new { Texto = "Partos", Paginas = new[] { "/PagesReproduccion/ListaPartos", "/PagesReproduccion/RegistrarParto", "/PagesReproduccion/ModificarParto" } }
            }
        },
        new
        {
            Titulo = "Sanidad",
            Icono = "sanidad",
            Id = "seccionSanidad",
            Items = new[]
            {
                new { Texto = "Diagnósticos", Paginas = new[] { "/PagesSanidad/ListaDiagnosticos", "/PagesSanidad/RegistrarDiagnostico" } },
                new { Texto = "Tratamientos", Paginas = new[] { "/PagesSanidad/ListaTratamientos", "/PagesSanidad/RegistrarTratamiento" } },
                new { Texto = "Vacunaciones", Paginas = new[] { "/PagesSanidad/ListaVacunaciones", "/PagesSanidad/RegistrarVacunacion" } },
                new { Texto = "Descornes", Paginas = new[] { "/PagesSanidad/ListaDescornes", "/PagesSanidad/RegistrarDescorne" } },
                new { Texto = "Planes sanitarios", Paginas = new[] { "/PagesSanidad/ListaPlanes", "/PagesSanidad/ConfigurarPlan" } }
            }
        },
        new
        {
            Titulo = "Insumos",
            Icono = "insumos",
            Id = "seccionInsumos",
            Items = new[]
            {
                new { Texto = "Insumos y stock", Paginas = new[] { "/PagesInsumo/ListaInsumos", "/PagesInsumo/AltaInsumo", "/PagesInsumo/IngresoStock", "/PagesInsumo/ConfigurarStockMinimo" } },
                new { Texto = "Movimientos", Paginas = new[] { "/PagesInsumo/HistorialMovimientos" } }
            }
        },
        new
        {
            Titulo = "Indicadores",
            Icono = "indicadores",
            Id = "seccionIndicadores",
            Items = new[]
            {
                new { Texto = "Indicadores del rodeo", Paginas = new[] { "/PagesIndicadores/Indicadores" } },
                new { Texto = "Candidatas a descarte", Paginas = new[] { "/PagesIndicadores/CandidatasDescarte" } }
            }
        },
        new
        {
            Titulo = "Reportes",
            Icono = "reportes",
            Id = "seccionReportes",
            Items = new[]
            {
                new { Texto = "Productivo", Paginas = new[] { "/PagesReportes/ReporteProductivo" } },
                new { Texto = "Sanitario", Paginas = new[] { "/PagesReportes/ReporteSanitario" } },
                new { Texto = "Reproductivo", Paginas = new[] { "/PagesReportes/ReporteReproductivo" } },
                new { Texto = "Genético", Paginas = new[] { "/PagesReportes/ReporteGenetico" } }
            }
        }
    };

    bool vAutenticado = User.Identity != null && User.Identity.IsAuthenticated;

    // El sprite de íconos. La dirección se resuelve acá y no con "~/" en cada
    // uso porque el tilde solo lo traduce ASP.NET en una lista fija de
    // atributos, y el href de <use> no está en esa lista: quedaría escrito tal
    // cual y ningún ícono se vería.
    string vIconos = Url.Content("~/img/iconos.svg");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1c5139" />
    <title>@ViewData["Title"] - Gestión de Tambo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* tema.css define colores, tipografía y densidad; site.css los usa *@
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tesis.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    @* Hojas de estilo de una sola pantalla, para no cargarlas en todo el sitio *@
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    @* Lo primero que encuentra quien navega con teclado: le evita recorrer las
       treinta y pico de entradas del menú en cada pantalla. Criterio 2.4.1 *@
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>

    <header>
        <nav class="navbar barra-superior navbar-dark" aria-label="Barra superior">
            <div class="container-fluid gap-2">
                @if (vAutenticado)
                {
                    <button class="btn btn-outline-light btn-sm d-lg-none" type="button"
                            data-bs-toggle="collapse" data-bs-target="#menuLateral"
                            aria-controls="menuLateral" aria-expanded="false"
                            aria-label="Abrir el menú de navegación">
                        <svg class="ico ico-lg" aria-hidden="true"><use href="@vIconos#menu"></use></svg>
                    </button>
                }

                <a class="navbar-brand me-auto" asp-area="" asp-page="/Index">
                    <svg class="ico ico-lg" aria-hidden="true"><use href="@vIconos#produccion"></use></svg>
                    Gestión de Tambo
                </a>

                @if (vAutenticado)
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @* Buscador de caravana: lleva directo a la ficha del animal *@
                        <form class="d-flex" method="get" asp-page="/PagesAnimal/DetalleAnimal" role="search">
                            <label class="visually-hidden" for="buscarCaravana">Buscar por caravana</label>
                            <input class="form-control form-control-sm me-1 buscador-caravana" type="search"
                                   id="buscarCaravana" name="caravana" placeholder="Caravana" />
                            <button class="btn btn-sm btn-outline-light" type="submit">
                                <svg class="ico" aria-hidden="true"><use href="@vIconos#buscar"></use></svg>
                                <span class="visually-hidden">Buscar</span>
                            </button>
                        </form>

                        <span class="navbar-text small d-none d-sm-inline">@User.Identity.Name</span>

                        <form method="post" asp-page="/PagesSeguridad/Login" asp-page-handler="Salir">
                            @* En pantalla chica queda solo el ícono, pero el
                               nombre accesible lo sigue dando el aria-label *@
                            <button type="submit" class="btn btn-sm btn-outline-light"
                                    aria-label="Cerrar sesión">
                                <svg class="ico" aria-hidden="true"><use href="@vIconos#salir"></use></svg>
                                <span class="d-none d-sm-inline">Cerrar sesión</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light" asp-area="" asp-page="/PagesSeguridad/Login">
                        Iniciar sesión
                    </a>
                }
            </div>
        </nav>
    </header>

    <div class="disposicion">
        @if (vAutenticado)
        {
            <nav class="menu-lateral collapse d-lg-block" id="menuLateral" aria-label="Menú principal">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(vPaginaActual == "/Index" ? "activo" : "")"
                           aria-current="@(vPaginaActual == "/Index" ? "page" : null)"
                           asp-area="" asp-page="/Index">
                            <svg class="ico" aria-hidden="true"><use href="@vIconos#hoy"></use></svg>
                            Hoy en el tambo
                        </a>
                    </li>
                </ul>

                @foreach (var seccion in vSecciones)
                {
                    bool vSeccionActiva = seccion.Items.Any(i => i.Paginas.Contains(vPaginaActual));

                    <div class="menu-seccion">
                        <button class="menu-titulo @(vSeccionActiva ? "activa" : "")" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@seccion.Id"
                                aria-controls="@seccion.Id"
                                aria-expanded="@(vSeccionActiva ? "true" : "false")">
                            <svg class="ico" aria-hidden="true"><use href="@vIconos#@seccion.Icono"></use></svg>
                            @seccion.Titulo
                            <svg class="ico ico-flecha" aria-hidden="true"><use href="@vIconos#desplegar"></use></svg>
                        </button>
                        <div class="collapse @(vSeccionActiva ? "show" : "")" id="@seccion.Id">
                            <ul class="nav flex-column">
                                @foreach (var item in seccion.Items)
                                {
                                    bool vItemActivo = item.Paginas.Contains(vPaginaActual);

                                    <li class="nav-item">
                                        <a class="nav-link @(vItemActivo ? "activo" : "")"
                                           aria-current="@(vItemActivo ? "page" : null)"
                                           asp-page="@item.Paginas[0]">@item.Texto</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <ul class="nav flex-column menu-pie">
                    <li class="nav-item">
                        <a class="nav-link @(vPaginaActual == "/PagesConfiguracion/Configuracion" ? "activo" : "")"
                           aria-current="@(vPaginaActual == "/PagesConfiguracion/Configuracion" ? "page" : null)"
                           asp-page="/PagesConfiguracion/Configuracion">
                            <svg class="ico" aria-hidden="true"><use href="@vIconos#configuracion"></use></svg>
                            Configuración
                        </a>
                    </li>
                </ul>
            </nav>
        }

        @* tabindex -1 para que el salto de arriba pueda dejar el foco acá *@
        <main role="main" class="contenido" id="contenido" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Pagina sola cualquier tabla que declare data-paginar *@
    <script src="~/js/paginador.js" asp-append-version="true"></script>
    @* Vuelve tarjetas las tablas en pantalla angosta, sin tocar las pantallas *@
    <script src="~/js/tablaMovil.js" asp-append-version="true"></script>
    @* Pide confirmación en cualquier formulario que declare data-confirmar *@
    <script src="~/js/confirmacion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
