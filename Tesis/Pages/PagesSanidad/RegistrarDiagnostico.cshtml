@page
@model Tesis.Pages.PagesSanidad.RegistrarDiagnosticoModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Registrar Diagnostico</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Animal', '', true)">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaDiagnostico">Fecha:</label>
                    <input type="date" id="fechaDiagnostico" name="fechaDiagnostico" class="form-control"
                           value="@Model.fechaDiagnostico.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <select id="estado" name="estado" asp-for="estado" class="form-control">
                        <option value="@Dominio.Diagnostico.ACTIVO">@Dominio.Diagnostico.ACTIVO</option>
                        <option value="@Dominio.Diagnostico.EN_TRATAMIENTO">@Dominio.Diagnostico.EN_TRATAMIENTO</option>
                        <option value="@Dominio.Diagnostico.RESUELTO">@Dominio.Diagnostico.RESUELTO</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="enfermedad">Enfermedad o resultado de la revisacion:</label>
                    <input type="text" id="enfermedad" name="enfermedad" class="form-control"
                           maxlength="100" value="@Model.enfermedad" />
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="Guardar">Guardar</button>
                <a class="btn btn-info" asp-page="./RegistrarTratamiento">Registrar Tratamiento</a>
                <a class="btn btn-warning" asp-page="./ListaDiagnosticos">Volver</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
