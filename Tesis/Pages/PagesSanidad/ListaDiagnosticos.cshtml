@page
@model Tesis.Pages.PagesSanidad.ListaDiagnosticosModel
@{
    ViewData["Title"] = "Diagnósticos";
}
<div>
    <div class="encabezado-pagina">
        <div>
            <h1>Diagnósticos</h1>
            <small class="text-muted">@Model.diagnosticos.Count diagnósticos registrados.</small>
        </div>
        <a class="btn btn-primary" asp-page="./RegistrarDiagnostico">Registrar diagnóstico</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    }

    <table data-paginar="10" class="table align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Caravana</th>
                <th>Enfermedad</th>
                <th>Estado</th>
                <th>Tratamientos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.diagnosticos.Any())
            {
                @foreach (Dominio.Diagnostico diagnostico in Model.diagnosticos)
                {
                    <tr>
                        <td>@diagnostico.FechaDiagnostico.ToShortDateString()</td>
                        <td>@(diagnostico.Animal != null ? diagnostico.Animal.NumCaravana : "")</td>
                        <td>@diagnostico.Enfermedad</td>
                        <td>
                            @if (diagnostico.Estado == Dominio.Diagnostico.RESUELTO)
                            {
                                <span class="badge bg-secondary">@diagnostico.Estado</span>
                            }
                            else if (diagnostico.Estado == Dominio.Diagnostico.EN_TRATAMIENTO)
                            {
                                <span class="badge bg-primary">@diagnostico.Estado</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@diagnostico.Estado</span>
                            }

                            @if (diagnostico.Estado != Dominio.Diagnostico.RESUELTO)
                            {
                                <form method="post" asp-page-handler="Resolver"
                                      asp-route-id="@diagnostico.IdDiagnostico" class="mt-1">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        Marcar resuelto
                                    </button>
                                </form>
                            }
                        </td>
                        <td>@Model.tratamientosPorDiagnostico[diagnostico.IdDiagnostico]</td>
                        <td>
                            <partial name="_AccionesRegistro" model="@(new Tesis.Pages.Shared.AccionesRegistroModelo
                                {
                                    PaginaEditar = "./RegistrarDiagnostico",
                                    Id = diagnostico.IdDiagnostico,
                                    MotivoBloqueo = Model.bloqueos[diagnostico.IdDiagnostico],
                                    Descripcion = "el diagnostico de " + diagnostico.Enfermedad
                                        + " del " + diagnostico.FechaDiagnostico.ToShortDateString()
                                        + " de la caravana "
                                        + (diagnostico.Animal != null ? diagnostico.Animal.NumCaravana : "")
                                })" />
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">No hay diagnosticos registrados</td>
                </tr>
            }
        </tbody>
    </table>
</div>
