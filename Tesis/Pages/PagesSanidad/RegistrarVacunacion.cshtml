@page
@model Tesis.Pages.PagesSanidad.RegistrarVacunacionModel
@{
    ViewData["Title"] = Model.esCorreccion ? "Corregir vacunación" : "Registrar vacunación";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
@*
    El listado de aplicaciones que esta pantalla mostraba abajo se mudo a
    ListaVacunaciones, que es de donde ahora se llega hasta aca. El formulario se
    queda solo con lo suyo.
*@
<div class="panel-formulario">
    <h1>
        @(Model.esCorreccion ? "Corregir Vacunacion" : "Registrar Vacunacion")
    </h1>
    <p class="text-muted">
        La aplicación descuenta una dosis del stock. Si cumple un plan sanitario,
        indicarlo es lo que hace que el calendario deje de pedirla.
    </p>
    <hr />

    @if (Model.esCorreccion)
    {
        <div class="alert alert-info">
            <strong>Se está corrigiendo una vacunación ya registrada.</strong>
            Si se cambia la vacuna, el sistema devuelve la dosis anterior al stock y
            descuenta la nueva, dejando los dos movimientos asentados en el historial.
        </div>
    }

    <form method="post">
        <input type="hidden" name="id" value="@Model.id" />
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Animal', '', true)">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="idInsumo">Vacuna aplicada:</label>
                    <select id="idInsumo" name="idInsumo" asp-for="idInsumo" class="form-control">
                        <option value="0">Seleccione una vacuna</option>
                        @foreach (Dominio.Insumo vacuna in Model.vacunas)
                        {
                            <option value="@vacuna.IdInsumo">
                                @vacuna.Nombre &mdash; stock @vacuna.StockActual.ToString("N2")
                            </option>
                        }
                    </select>
                    @if (!Model.vacunas.Any())
                    {
                        <small class="text-danger">
                            No hay vacunas cargadas. Se dan de alta desde
                            <a asp-page="/PagesInsumo/AltaInsumo">Insumos</a>.
                        </small>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaAplicacion">Fecha de aplicacion:</label>
                    <input type="date" id="fechaAplicacion" name="fechaAplicacion" class="form-control"
                           value="@Model.fechaAplicacion.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="form-group">
                    <label for="idPlan">Plan sanitario que cumple:</label>
                    <select id="idPlan" name="idPlan" asp-for="idPlan" class="form-control">
                        <option value="0">Fuera de plan</option>
                        @foreach (Dominio.PlanSanitario plan in Model.planes)
                        {
                            <option value="@plan.IdPlan">@plan.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">
                    @(Model.esCorreccion ? "Guardar cambios" : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" asp-page="./ListaVacunaciones">Cancelar</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
