@page
@model Tesis.Pages.PagesSanidad.RegistrarTratamientoModel
@{
    ViewData["Title"] = Model.esCorreccion ? "Corregir tratamiento" : "Registrar tratamiento";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="panel-formulario">
    <h1>
        @(Model.esCorreccion ? "Corregir Tratamiento Sanitario" : "Registrar Tratamiento Sanitario")
    </h1>
    <p class="text-muted">
        El tratamiento descuenta el producto del stock y fija hasta cuándo hay que
        descartar la leche del animal. Mientras el descarte esté vigente, el sistema lo
        deja fuera del lote de ordeñe.
    </p>
    <hr />

    @if (Model.esCorreccion)
    {
        <div class="alert alert-info">
            <strong>Se está corrigiendo un tratamiento ya registrado.</strong>
            Al guardar, el sistema devuelve al stock lo que este tratamiento había
            consumido y descuenta lo nuevo, dejando los dos movimientos asentados en el
            historial. El descarte de leche se vuelve a calcular: revisá la fecha antes
            de guardar.
        </div>
    }

    <form method="post">
        <input type="hidden" name="id" value="@Model.id" />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="idDiagnostico">Diagnostico que lo origina:</label>
                    <select id="idDiagnostico" name="idDiagnostico" asp-for="idDiagnostico" class="form-control">
                        <option value="0">Sin diagnostico (tratamiento preventivo)</option>
                        @foreach (Dominio.Diagnostico diagnostico in Model.diagnosticos)
                        {
                            <option value="@diagnostico.IdDiagnostico">
                                @(diagnostico.Animal != null ? diagnostico.Animal.NumCaravana : "")
                                &mdash; @diagnostico.Enfermedad
                                (@diagnostico.FechaDiagnostico.ToShortDateString())
                            </option>
                        }
                    </select>
                    <small class="text-muted">
                        Si el tratamiento es preventivo &mdash;una desparasitación, por
                        ejemplo&mdash; no elija diagnóstico e indique la caravana del animal.
                    </small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana (tratamiento preventivo):</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Animal', '', true)">
                            Buscar
                        </button>
                    </div>
                    <small class="text-muted">
                        Si eligió un diagnóstico, el animal sale de él y este campo se ignora.
                    </small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="idInsumo">Producto aplicado:</label>
                    <select id="idInsumo" name="idInsumo" asp-for="idInsumo" class="form-control">
                        <option value="0">Seleccione un producto</option>
                        @foreach (Dominio.Insumo insumo in Model.insumos)
                        {
                            <option value="@insumo.IdInsumo">
                                @insumo.Nombre &mdash; stock @insumo.StockActual.ToString("N2")
                                @if (insumo.PeriodoDescarteDias > 0)
                                {
                                    <text>&mdash; carencia @insumo.PeriodoDescarteDias d</text>
                                }
                            </option>
                        }
                    </select>
                    @if (!Model.insumos.Any())
                    {
                        <small class="text-danger">
                            No hay productos sanitarios cargados. Se dan de alta desde
                            <a asp-page="/PagesInsumo/AltaInsumo">Insumos</a>.
                        </small>
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaInicio">Fecha de inicio:</label>
                    <input type="date" id="fechaInicio" name="fechaInicio" class="form-control"
                           value="@Model.fechaInicio.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="diasDuracion">Duracion (dias):</label>
                    <input type="number" min="1" id="diasDuracion" name="diasDuracion"
                           class="form-control" value="@Model.diasDuracion" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="dosisDiaria">Dosis diaria:</label>
                    <input type="text" id="dosisDiaria" name="dosisDiaria" class="form-control"
                           maxlength="60" value="@Model.dosisDiaria" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="cantidadInsumo">Unidades a descontar:</label>
                    <input type="number" step="0.01" min="0" id="cantidadInsumo" name="cantidadInsumo"
                           class="form-control" value="@Tesis.Pages.Shared.CampoNumerico.Escribir(Model.cantidadInsumo)" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="form-group">
                    <label for="idPlan">Plan sanitario que cumple:</label>
                    <select id="idPlan" name="idPlan" asp-for="idPlan" class="form-control">
                        <option value="0">Fuera de plan</option>
                        @foreach (Dominio.PlanSanitario plan in Model.planes)
                        {
                            <option value="@plan.IdPlan">@plan.Nombre</option>
                        }
                    </select>
                    <small class="text-muted">
                        Solo planes de desparasitación activos. Declararlo es lo que hace que
                        el calendario sanitario deje de pedir el procedimiento.
                    </small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="fechaFinDescarte">Descarte de leche hasta:</label>
                    <div class="input-group">
                        <input type="date" id="fechaFinDescarte" name="fechaFinDescarte" class="form-control"
                               value="@(Model.fechaFinDescarte != DateTime.MinValue ? Model.fechaFinDescarte.ToString("yyyy-MM-dd") : "")" />
                        <button type="submit" class="btn btn-secondary" asp-page-handler="CalcularDescarte">
                            Calcular
                        </button>
                    </div>
                    <small class="text-muted">
                        La propone el sistema sumando la duración del tratamiento y el
                        período de carencia del producto. Se puede ajustar.
                    </small>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">
                    @(Model.esCorreccion ? "Guardar cambios" : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" asp-page="./ListaTratamientos">Cancelar</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
