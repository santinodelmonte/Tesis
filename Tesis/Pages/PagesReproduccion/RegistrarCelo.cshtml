@page
@model Tesis.Pages.PagesReproduccion.RegistrarCeloModel
@{
    ViewData["Title"] = Model.esCorreccion ? "Corregir celo" : "Registrar celo";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="panel-formulario">
    <h1>
        @(Model.esCorreccion ? "Corregir Deteccion de Celo" : "Registrar Deteccion de Celo")
    </h1>
    <hr />

    @if (Model.esCorreccion)
    {
        <div class="alert alert-info">
            Se esta corrigiendo un celo ya registrado. El celo no arrastra nada:
            no mueve el estado de la vaca ni consume insumos, asi que la correccion
            no afecta a ningun otro registro.
        </div>
    }

    <form method="post">
        <input type="hidden" name="id" value="@Model.id" />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Hembra', 'H', true)">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="fecha">Fecha de deteccion:</label>
                    <input type="date" id="fecha" name="fecha" class="form-control"
                           value="@Model.fecha.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="observaciones">Observaciones:</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="3"
                              maxlength="200">@Model.observaciones</textarea>
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">
                    @(Model.esCorreccion ? "Guardar cambios" : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" asp-page="./ListaCelos">Cancelar</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
