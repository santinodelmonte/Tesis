@page
@model Tesis.Pages.PagesReproduccion.RegistrarCeloModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Registrar Deteccion de Celo</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Hembra', 'H', true)">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="fecha">Fecha de deteccion:</label>
                    <input type="date" id="fecha" name="fecha" class="form-control"
                           value="@Model.fecha.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="observaciones">Observaciones:</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="3"
                              maxlength="200">@Model.observaciones</textarea>
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="Guardar">Guardar</button>
                <a class="btn btn-info" asp-page="./RegistrarServicio">Registrar Servicio</a>
                <a class="btn btn-warning" asp-page="./ListaCelos">Volver</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
