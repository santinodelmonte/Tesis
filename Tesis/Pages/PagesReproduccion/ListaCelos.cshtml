@page
@model Tesis.Pages.PagesReproduccion.ListaCelosModel
@{
    ViewData["Title"] = "Celos";
}
<div>
    <div class="encabezado-pagina">
        <div>
            <h1>Celos detectados</h1>
            <small class="text-muted">@Model.celos.Count celos registrados.</small>
        </div>
        <a class="btn btn-primary" asp-page="./RegistrarCelo">Registrar celo</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    }

    <table data-paginar="10" class="table align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Caravana</th>
                <th>Categoria</th>
                <th>Estado reproductivo</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.celos.Any())
            {
                @foreach (Dominio.Celo celo in Model.celos)
                {
                    <tr>
                        <td>@celo.Fecha.ToShortDateString()</td>
                        <td>@(celo.Animal != null ? celo.Animal.NumCaravana : "")</td>
                        <td>@(celo.Animal != null && celo.Animal.Categoria != null ? celo.Animal.Categoria.Nombre : "")</td>
                        <td>@(celo.Animal != null ? celo.Animal.EstadoReproductivo : "")</td>
                        <td>@celo.Observaciones</td>
                        <td>
                            <partial name="_AccionesRegistro" model="@(new Tesis.Pages.Shared.AccionesRegistroModelo
                                {
                                    PaginaEditar = "./RegistrarCelo",
                                    Id = celo.IdCelo,
                                    Descripcion = "el celo del " + celo.Fecha.ToShortDateString()
                                        + " de la caravana " + (celo.Animal != null ? celo.Animal.NumCaravana : "")
                                })" />
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No hay celos registrados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
