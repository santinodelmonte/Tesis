@page
@model Tesis.Pages.PagesReproduccion.RegistrarTactoModel
@{
    ViewData["Title"] = Model.esCorreccion ? "Corregir tacto" : "Registrar tacto";
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="panel-formulario">
    <h1>
        @(Model.esCorreccion ? "Corregir Tacto" : "Registrar Tacto y Confirmacion de Preñez")
    </h1>
    <p class="text-muted">
        El tacto modifica el estado reproductivo y nunca el productivo: una vaca en
        lactancia confirmada preñada sigue produciendo.
    </p>
    <hr />

    @if (Model.esCorreccion)
    {
        <div class="alert alert-info">
            <strong>Se está corrigiendo un tacto ya registrado.</strong>
            Al guardar, el sistema vuelve a deducir si la vaca queda preñada, vacía o
            servida a partir de los controles que quedan, y ajusta la fecha probable de
            parto de su lactancia. El servicio no se cambia: si el control se anotó en
            el servicio equivocado, hay que eliminarlo y registrarlo de nuevo.
        </div>
    }

    <form method="post">
        <input type="hidden" name="id" value="@Model.id" />
        <input type="hidden" name="idServicio" value="@Model.idServicio" />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        @if (!Model.esCorreccion)
                        {
                            <button type="button" class="btn btn-secondary"
                                    onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Hembra', 'H', true)">
                                Buscar
                            </button>
                            <button type="submit" class="btn btn-primary" asp-page-handler="BuscarServicio">
                                Ver servicio
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaTacto">Fecha del tacto:</label>
                    <input type="date" id="fechaTacto" name="fechaTacto" class="form-control"
                           value="@Model.fechaTacto.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="resultado">Resultado:</label>
                    <select id="resultado" name="resultado" asp-for="resultado" class="form-control">
                        <option value="@Dominio.Tacto.PRENADA">@Dominio.Tacto.PRENADA</option>
                        <option value="@Dominio.Tacto.VACIA">@Dominio.Tacto.VACIA</option>
                        <option value="@Dominio.Tacto.DUDOSA">@Dominio.Tacto.DUDOSA</option>
                    </select>
                </div>
            </div>
        </div>

        @if (Model.servicioVigente != null)
        {
            <div class="alert alert-info">
                <strong>Servicio sobre el que se registra el control</strong><br />
                Fecha: @Model.servicioVigente.FechaServicio.ToShortDateString()
                &mdash; Tipo: @Model.servicioVigente.TipoServicio
                @if (Model.servicioVigente.Toro != null)
                {
                    <text>&mdash; Toro: @Model.servicioVigente.Toro.NumCaravana</text>
                }
                else if (Model.servicioVigente.Pajuela != null)
                {
                    <text>&mdash; Pajuela: @Model.servicioVigente.Pajuela.Nombre</text>
                }
                <br />
                Fecha probable de parto: @Model.servicioVigente.FechaProbableParto.ToShortDateString()

                @if (Model.tactosDelServicio.Any())
                {
                    <hr />
                    <strong>Controles anteriores de este servicio</strong>
                    <ul class="mb-0">
                        @foreach (Dominio.Tacto tacto in Model.tactosDelServicio)
                        {
                            <li>@tacto.FechaTacto.ToShortDateString(): @tacto.Resultado</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="observaciones">Observaciones:</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="2"
                              maxlength="200">@Model.observaciones</textarea>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">
                    @(Model.esCorreccion ? "Guardar cambios" : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" asp-page="./ListaTactos">Cancelar</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />
