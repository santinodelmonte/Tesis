@page
@model Tesis.Pages.PagesReproduccion.RegistrarPartoModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/fotoAnimal.js" asp-append-version="true"></script>
}
<div class="panel-formulario">
    <h1>Registrar Parto</h1>
    <p class="text-muted">
        El parto cierra el ciclo reproductivo devolviendo la hembra a "Vacía" e inicia
        el productivo llevándola a "En lactancia". Además da de alta la cría y abre la
        lactancia nueva.
    </p>
    <hr />
    <form method="post">
        <h2 class="h5">Madre</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaTexto">Caravana:</label>
                    <div class="input-group">
                        <input type="hidden" id="numCaravana" name="numCaravana" value="@Model.numCaravana" />
                        <input type="text" id="caravanaTexto" class="form-control" readonly
                               value="@Model.numCaravana" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('numCaravana', 'caravanaTexto', 'Seleccionar Madre', 'H', true)">
                            Buscar
                        </button>
                        <button type="submit" class="btn btn-primary" asp-page-handler="BuscarMadre">
                            Cargar datos
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaParto">Fecha del parto:</label>
                    <input type="date" id="fechaParto" name="fechaParto" class="form-control"
                           value="@Model.fechaParto.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="tipoParto">Tipo de parto:</label>
                    <select id="tipoParto" name="tipoParto" asp-for="tipoParto" class="form-control">
                        <option value="@Dominio.Parto.NORMAL">@Dominio.Parto.NORMAL</option>
                        <option value="@Dominio.Parto.DISTOCICO">@Dominio.Parto.DISTOCICO</option>
                        <option value="@Dominio.Parto.CESAREA">@Dominio.Parto.CESAREA</option>
                    </select>
                </div>
            </div>
        </div>

        @if (Model.madre != null)
        {
            <div class="alert alert-info">
                <strong>@Model.madre.NumCaravana</strong>
                &mdash; @(Model.madre.Categoria != null ? Model.madre.Categoria.Nombre : "")
                &mdash; @Model.madre.NumeroPartos parto(s) registrado(s)
                &mdash; productivo: @Model.madre.EstadoProductivo
                &mdash; reproductivo: @Model.madre.EstadoReproductivo
                @if (Model.servicioVigente != null)
                {
                    <br />
                    <text>
                        Servicio del @Model.servicioVigente.FechaServicio.ToShortDateString()
                        (@Model.servicioVigente.TipoServicio),
                        parto proyectado para @Model.servicioVigente.FechaProbableParto.ToShortDateString().
                    </text>
                }
                else
                {
                    <br />
                    <span class="text-danger">
                        No hay un servicio registrado para esta hembra: la cría va a quedar sin padre sugerido.
                    </span>
                }
            </div>

            @* CU18 pone como pre-condicion que la madre figure preñada. No se bloquea a
               proposito: hay que poder cargar el parto de una vaca a la que nunca se le
               registró el tacto. Pero conviene avisarlo, porque suele indicar que falta
               cargar algo. *@
            @if (Model.madre.EstadoReproductivo != Dominio.Hembra.PRENADA)
            {
                <div class="alert alert-warning">
                    El animal no figura preñado (estado reproductivo:
                    <strong>@Model.madre.EstadoReproductivo</strong>). El parto se puede
                    registrar igual, pero revisá si falta cargar el servicio o el tacto.
                </div>
            }

            @if (Model.madre.EstadoProductivo == Dominio.Hembra.EN_LACTANCIA)
            {
                <div class="alert alert-warning">
                    El animal figura en lactancia, o sea que no se le registró el secado.
                    Al confirmar el parto, el sistema cierra esa lactancia con la fecha
                    del parto y abre la nueva.
                </div>
            }
        }

        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="observaciones">Observaciones del parto:</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="2"
                              maxlength="200">@Model.observaciones</textarea>
                </div>
            </div>
        </div>

        <hr />
        <h2 class="h5">Cria</h2>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="caravanaCria">Numero de caravana:</label>
                    <input type="text" id="caravanaCria" name="caravanaCria" class="form-control"
                           maxlength="20" value="@Model.caravanaCria" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="sexoCria">Sexo:</label>
                    <select id="sexoCria" name="sexoCria" asp-for="sexoCria" class="form-control">
                        <option value="H">Hembra</option>
                        <option value="M">Macho</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="idRazaCria">Raza:</label>
                    <select id="idRazaCria" name="idRazaCria" asp-for="idRazaCria" class="form-control">
                        <option value="0">Seleccione una raza</option>
                        @foreach (Dominio.Raza raza in Model.razas)
                        {
                            <option value="@raza.IdRaza">@raza.Nombre</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaPadreTexto">Padre:</label>
                    <div class="input-group">
                        <input type="hidden" id="idPadre" name="idPadre" value="@Model.idPadre" />
                        <input type="text" id="caravanaPadreTexto" class="form-control" readonly
                               value="@Model.caravanaPadre" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('idPadre', 'caravanaPadreTexto', 'Seleccionar Padre', 'M', false)">
                            Cambiar
                        </button>
                    </div>
                    @if (Model.padreSugerido != null)
                    {
                        <small class="text-muted">
                            Propuesto a partir del reproductor del servicio.
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @* El ternero se caravanea al nacer: es el momento en que se le puede
                   sacar la foto sin buscarlo despues en el rodeo *@
                <partial name="_CampoFoto" model="@(new Tesis.Pages.Shared.CampoFotoModelo
                         {
                             Campo = "fotoCria",
                             Etiqueta = "Foto de la cría:",
                             Valor = Model.fotoCria,
                             Ayuda = "Opcional. Se achica sola antes de subirse y se puede sacar con la cámara."
                         })" />
            </div>
        </div>
        <p class="text-muted">
            La categoría de la cría (ternera o ternero) y su fecha de nacimiento las
            completa el sistema con la fecha del parto.
        </p>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="partoDoble" name="partoDoble"
                   value="true" checked="@Model.partoDoble" onchange="cambiarPartoDoble()" />
            <label class="form-check-label" for="partoDoble">
                <strong>Parto doble (mellizos)</strong> &mdash; suma un solo parto y una
                sola lactancia a la madre, pero da de alta las dos crías.
            </label>
        </div>

        <div id="bloqueCria2" style="display: none">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="caravanaCria2">Caravana de la segunda cría:</label>
                        <input type="text" id="caravanaCria2" name="caravanaCria2" class="form-control"
                               maxlength="20" value="@Model.caravanaCria2" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="sexoCria2">Sexo:</label>
                        <select id="sexoCria2" name="sexoCria2" asp-for="sexoCria2" class="form-control">
                            <option value="H">Hembra</option>
                            <option value="M">Macho</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="idRazaCria2">Raza:</label>
                        <select id="idRazaCria2" name="idRazaCria2" asp-for="idRazaCria2" class="form-control">
                            <option value="0">Seleccione una raza</option>
                            @foreach (Dominio.Raza raza in Model.razas)
                            {
                                <option value="@raza.IdRaza">@raza.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <partial name="_CampoFoto" model="@(new Tesis.Pages.Shared.CampoFotoModelo
                             {
                                 Campo = "fotoCria2",
                                 Etiqueta = "Foto de la segunda cría:",
                                 Valor = Model.fotoCria2,
                                 Ayuda = "Opcional."
                             })" />
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>

        @if (Model.advertencias.Any())
        {
            <div class="alert alert-warning mt-2">
                <strong>Revise antes de confirmar:</strong>
                <ul class="mb-2 mt-2">
                    @foreach (string advertencia in Model.advertencias)
                    {
                        <li>@advertencia</li>
                    }
                </ul>
                El parto no se registró. Corrija los datos, o confírmelo igual si la
                información es correcta.
                <div class="mt-2">
                    <button type="submit" class="btn btn-warning" asp-page-handler="ConfirmarParto"
                            name="confirmado" value="true">
                        Confirmar de todos modos
                    </button>
                </div>
            </div>
        }

        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="ConfirmarParto">Confirmar Parto</button>
                <a class="btn btn-outline-secondary" asp-page="./AlertasParto">Alertas de Parto</a>
                <a class="btn btn-warning" asp-page="./ListaServicios">Volver</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />

<script>
    // Los campos de la segunda cria solo se muestran cuando el parto fue doble
    function cambiarPartoDoble() {
        var doble = document.getElementById("partoDoble").checked;
        document.getElementById("bloqueCria2").style.display = doble ? "" : "none";
    }

    cambiarPartoDoble();
</script>
