@page
@model Tesis.Pages.PagesInsumo.ConfigurarStockMinimoModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="panel-formulario">
    <h1>Configurar Stock Minimo</h1>
    <p class="text-muted">
        Cantidad de reserva por debajo de la cual el insumo aparece en las alertas de
        stock crítico.
    </p>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="idInsumo">Insumo:</label>
                    <select id="idInsumo" name="idInsumo" asp-for="idInsumo" class="form-control">
                        <option value="0">Seleccione un insumo</option>
                        @foreach (Dominio.Insumo insumo in Model.insumos)
                        {
                            <option value="@insumo.IdInsumo">
                                @insumo.Nombre (@insumo.TipoInsumo) &mdash;
                                stock @insumo.StockActual.ToString("N2"),
                                minimo actual @insumo.StockMinimo.ToString("N2")
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="stockMinimo">Stock minimo:</label>
                    <input type="number" step="0.01" min="0" id="stockMinimo" name="stockMinimo"
                           class="form-control" value="@Tesis.Pages.Shared.CampoNumerico.Escribir(Model.stockMinimo)" />
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-primary" asp-page-handler="Guardar">Guardar</button>
                <a class="btn btn-warning" asp-page="./ListaInsumos">Volver</a>
            </div>
        </div>
    </form>
</div>
