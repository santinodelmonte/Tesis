@page
@model Tesis.Pages.PagesInsumo.IngresoStockModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Registrar Ingreso de Stock</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="idInsumo">Insumo:</label>
                    <select id="idInsumo" name="idInsumo" asp-for="idInsumo" class="form-control">
                        <option value="0">Seleccione un insumo</option>
                        @foreach (Dominio.Insumo insumo in Model.insumos)
                        {
                            <option value="@insumo.IdInsumo">
                                @insumo.Nombre (@insumo.TipoInsumo) &mdash; stock @insumo.StockActual.ToString("N2")
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="cantidad">Cantidad:</label>
                    <input type="number" step="0.01" min="0" id="cantidad" name="cantidad"
                           class="form-control" value="@Model.cantidad" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fecha">Fecha del ingreso:</label>
                    <input type="date" id="fecha" name="fecha" class="form-control"
                           value="@Model.fecha.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="fechaVencimiento">Vencimiento de la partida:</label>
                    <input type="date" id="fechaVencimiento" name="fechaVencimiento" class="form-control"
                           value="@(Model.fechaVencimiento != DateTime.MinValue ? Model.fechaVencimiento.ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="motivo">Motivo:</label>
                    <input type="text" id="motivo" name="motivo" class="form-control"
                           maxlength="100" value="@Model.motivo" />
                </div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="RegistrarIngreso">Registrar Ingreso</button>
                <a class="btn btn-warning" asp-page="./ListaInsumos">Volver</a>
            </div>
        </div>
    </form>

    @if (Model.movimientos.Any())
    {
        <hr />
        <h5>
            Ultimos movimientos
            <a class="btn btn-info btn-sm ms-2" asp-page="./HistorialMovimientos">Ver historial completo</a>
        </h5>
        <table data-paginar="10" class="table table-sm text-center">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Insumo</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Vencimiento</th>
                    <th>Motivo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Dominio.MovimientoStock movimiento in Model.movimientos.Take(20))
                {
                    <tr>
                        <td>@movimiento.Fecha.ToShortDateString()</td>
                        <td>@(movimiento.Insumo != null ? movimiento.Insumo.Nombre : "")</td>
                        <td>
                            @if (movimiento.TipoMovimiento == Dominio.MovimientoStock.INGRESO)
                            {
                                <span class="badge bg-success">@movimiento.TipoMovimiento</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@movimiento.TipoMovimiento</span>
                            }
                        </td>
                        <td>@movimiento.Cantidad.ToString("N2")</td>
                        <td>
                            @if (movimiento.FechaVencimiento != DateTime.MinValue)
                            {
                                @movimiento.FechaVencimiento.ToShortDateString()
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>@movimiento.Motivo</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
