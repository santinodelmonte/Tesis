@page
@model Tesis.Pages.PagesInsumo.AltaInsumoModel
@{
}
@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
<div class="text-left">
    <h1 class="display-4" style="font-size: 40px">Agregar Insumo</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" class="form-control"
                           maxlength="100" value="@Model.nombre" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="tipoInsumo">Tipo:</label>
                    <select id="tipoInsumo" name="tipoInsumo" asp-for="tipoInsumo"
                            class="form-control" onchange="cambiarTipoInsumo()">
                        <option value="@Dominio.Insumo.PAJUELA">@Dominio.Insumo.PAJUELA</option>
                        <option value="@Dominio.Insumo.MEDICAMENTO">@Dominio.Insumo.MEDICAMENTO</option>
                        <option value="@Dominio.Insumo.VACUNA">@Dominio.Insumo.VACUNA</option>
                        <option value="@Dominio.Insumo.ANTIPARASITARIO">@Dominio.Insumo.ANTIPARASITARIO</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row" id="bloqueToro">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="caravanaToroTexto">Toro que aporta la pajuela:</label>
                    <div class="input-group">
                        <input type="hidden" id="idToro" name="idToro" value="@Model.idToro" />
                        <input type="text" id="caravanaToroTexto" class="form-control" readonly
                               value="@Model.caravanaToro" />
                        <button type="button" class="btn btn-secondary"
                                onclick="abrirSelectorAnimal('idToro', 'caravanaToroTexto', 'Seleccionar Toro', 'M', false)">
                            Buscar
                        </button>
                    </div>
                    <small class="text-muted">
                        Puede ser un toro de catálogo: se carga como animal con "En pie" desmarcado.
                    </small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="stockActual">Stock inicial:</label>
                    <input type="number" step="0.01" min="0" id="stockActual" name="stockActual"
                           class="form-control" value="@Model.stockActual" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="stockMinimo">Stock minimo:</label>
                    <input type="number" step="0.01" min="0" id="stockMinimo" name="stockMinimo"
                           class="form-control" value="@Model.stockMinimo" />
                </div>
            </div>
            <div class="col-md-3" id="bloqueDescarte" style="display: none">
                <div class="form-group">
                    <label for="periodoDescarteDias">Periodo de carencia (dias):</label>
                    <input type="number" min="0" id="periodoDescarteDias" name="periodoDescarteDias"
                           class="form-control" value="@Model.periodoDescarteDias" />
                    <small class="text-muted">
                        Dias que hay que descartar la leche despues del tratamiento. Cero si no obliga.
                    </small>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button type="submit" class="btn btn-success" asp-page-handler="AgregarInsumo">Guardar</button>
                <a class="btn btn-warning" asp-page="./ListaInsumos">Volver</a>
            </div>
        </div>
    </form>
</div>

<partial name="_SelectorAnimal" model="Model.animales" />

<script>
    // El toro solo aplica a la pajuela; el periodo de carencia, solo a los productos
    // sanitarios, que son los que obligan a descartar leche.
    function cambiarTipoInsumo() {
        var esPajuela = document.getElementById("tipoInsumo").value === "@Dominio.Insumo.PAJUELA";

        document.getElementById("bloqueToro").style.display = esPajuela ? "" : "none";
        document.getElementById("bloqueDescarte").style.display = esPajuela ? "none" : "";

        if (esPajuela) {
            document.getElementById("periodoDescarteDias").value = "0";
        } else {
            document.getElementById("idToro").value = "0";
            document.getElementById("caravanaToroTexto").value = "";
        }
    }

    cambiarTipoInsumo();
</script>
