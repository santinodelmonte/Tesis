<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Habilita dotnet user-secrets, que es donde viven la cadena de conexion, las
         credenciales del sistema y el token del bot durante el desarrollo. -->
    <UserSecretsId>tambo-gestion-tambo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
  </ItemGroup>

</Project>
